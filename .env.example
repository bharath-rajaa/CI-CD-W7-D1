# Copy to .env for local runs. Never commit .env (it is in .gitignore).
# In GitHub Actions, the same names are supplied from repository secrets.

TEST_USERNAME=demo
TEST_PASSWORD=demo-pass

# The sample app checks logins against these values. Keep them equal to TEST_* above.
APP_USERNAME=demo
APP_PASSWORD=demo-pass

# 'stable' (default) or 'defect'. 'defect' turns on the controlled product bug used in the lab.
APP_VARIANT=stable

# Optional: port for the bundled app
PORT=4173

# Optional: test a deployed environment instead of the bundled app
# BASE_URL=https://staging.example.com

# Optional: enables the AI review of CI logs (scripts/ai-review.mjs)
ANTHROPIC_API_KEY=
